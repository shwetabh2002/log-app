{
  "expo": {
    "name": "LogisticsHub",
    "slug": "log-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "log-app",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.logistics.marketplace",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LogisticsHub to access your photos for shipment listings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow LogisticsHub to find nearby shipments and carriers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
